configuration {

    // Timeout from user input.
    timeout {
        // The delay after inactivity to execute action.
        delay: 0;
        // The action to execute once the delay expires.
        action: "kb-cancel";
    }

    // File browser mode.
    filebrowser {
        sorting-method:    "name";
        directories-first: true;
    }

    /* Ranking weights (sort: true only). Combined: mode × entry. */
    // default-entry-weight: 1.0;
    // mode-weights {
    //     window: 1.2;
    //     p: 2.5;          /* script alias, e.g. p:rofi-power-menu */
    //     drun: 1.0;
    // }
    // entry-weights {
    //     "firefox.desktop": 1.5;
    //     "gimp.desktop": 0.8;
    // }
    // weight-patterns {
    //     "*.sh": 0.7;
    // }
}

@theme "default"
